{
  "name": "packcalendar",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "description": "予定にバッグを付けると、移す持ち物だけが分かるカレンダー",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "node scripts/serve-build.mjs",
    "test": "tsx --test tests/unit/*.test.ts",
    "check": "tsc --noEmit",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test:browser": "playwright test",
    "ios:sync": "npm run build && cap sync ios",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "dexie": "^4.4.6",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
